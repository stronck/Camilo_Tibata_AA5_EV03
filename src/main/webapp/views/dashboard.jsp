<%@ page import="java.util.*,com.controlstock.model.*" contentType="text/html;charset=UTF-8" %><% List<Cliente> clientes=(List<Cliente>)request.getAttribute("clientes"); List<Producto> productos=(List<Producto>)request.getAttribute("productos"); List<Venta> ventas=(List<Venta>)request.getAttribute("ventas"); %><!doctype html><html><head><meta charset="UTF-8"><title>ControlStock</title><link rel="stylesheet" href="<%=request.getContextPath()%>/css/estilos.css"></head><body><header><h1>ControlStock</h1><span>Administrador</span></header><main><section class="cards"><article><b><%=clientes.size()%></b><span>Clientes</span></article><article><b><%=productos.size()%></b><span>Productos</span></article><article><b><%=ventas.size()%></b><span>Ventas</span></article></section><section><h2>API REST disponible</h2><p>GET/POST/DELETE: <code>/api/clientes</code>, <code>/api/productos</code>, <code>/api/ventas</code></p></section><section><h2>Clientes</h2><table><tr><th>ID</th><th>Nombre</th><th>Correo</th><th>Teléfono</th></tr><% for(Cliente c:clientes){%><tr><td><%=c.getId()%></td><td><%=c.getNombre()%></td><td><%=c.getCorreo()%></td><td><%=c.getTelefono()%></td></tr><%}%></table></section><section><h2>Productos</h2><table><tr><th>ID</th><th>Nombre</th><th>Precio</th><th>Stock</th></tr><%for(Producto p:productos){%><tr><td><%=p.getId()%></td><td><%=p.getNombre()%></td><td>$<%=p.getPrecio()%></td><td><%=p.getStock()%></td></tr><%}%></table></section><section><h2>Ventas</h2><table><tr><th>ID</th><th>Cliente</th><th>Producto</th><th>Cant.</th><th>Total</th><th>Fecha</th></tr><%for(Venta v:ventas){%><tr><td><%=v.getId()%></td><td><%=v.getClienteId()%></td><td><%=v.getProductoId()%></td><td><%=v.getCantidad()%></td><td>$<%=v.getTotal()%></td><td><%=v.getFecha()%></td></tr><%}%></table></section></main></body></html>